# MongoDB reachable via kubectl port-forward (or a local Docker container).
# kubectl port-forward svc/mongodb 27017:27017 -n <namespace>
MONGO_URI=mongodb://localhost:27017/local_rag

OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
MONGO_COLLECTION=rag_chunks
MONGO_EMBEDDING_FIELD=embedding

OLLAMA_LLM_MODEL=llama3
LLM_TEMPERATURE=0.2

# Optional Groq fallback (leave empty to disable).
# GROQ_API_KEY=your_key_here
GROQ_MODEL=llama3-70b-8192
