# Postgres (shared cluster instance) reachable via kubectl port-forward
# (or a local Docker container). hialt-recall uses its own database + role
# on the shared instance — don't reuse another service's credentials here.
# kubectl port-forward svc/<postgres-service> 5432:5432 -n <namespace>
POSTGRES_URI=postgresql://hialt_recall:CHANGE_ME@localhost:5432/hialt_recall

OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# mxbai-embed-large produces 1024-dim vectors — must match whatever
# OLLAMA_EMBEDDING_MODEL actually produces, since pgvector columns are a
# fixed width set at table-creation time (see rag_engine.ensure_schema()).
EMBEDDING_DIM=1024
POSTGRES_TABLE=chunks
POSTGRES_FAILED_TABLE=chunks_failed

OLLAMA_LLM_MODEL=llama3
LLM_TEMPERATURE=0.2

# Optional Groq fallback (leave empty to disable).
# GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Kafka (ingest.py publishes chunks here; rag_consumer.py embeds them and
# writes the result to Postgres). Defaults below match a local port-forward /
# single-broker dev setup.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=hialt-recall-chunks
KAFKA_CONSUMER_GROUP=hialt-recall-workers
